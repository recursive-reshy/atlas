# Copy to apps/server/.env (never commit it). Loaded by `pnpm dev` and the integration tests.
# Empty values count as unset.

# --- Required ---

# Claude API key used to summarize transcripts and articles
ANTHROPIC_API_KEY=
# The Google account that becomes the admin on the first sign-in
ADMIN_EMAIL=
# Addresses the app is served at, comma-separated, no path (Vite serves the web app on 5173 in development)
APP_ORIGINS=http://localhost:5173
# Client ID of the Google "Web application" OAuth client (sign-in and Gmail)
GOOGLE_CLIENT_ID=
# Client secret of that OAuth client
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Gmail refresh token and signs the sign-in cookie: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Gemini transcribes YouTube videos through the Gemini Developer API (ADR 0083). The model, e.g. gemini-3.8-flash
GEMINI_MODEL=
# Gemini API key made in Google AI Studio on a paid tier
GEMINI_API_KEY=
# YouTube Data API v3 key, restricted to that API: title, channel and length of a video
YOUTUBE_API_KEY=

# --- Optional ---

# Port the API listens on (default: 3100)
PORT=3100
# Test double only (the e2e stack): another host for the Gemini API. Leave empty.
GEMINI_BASE_URL=
# Test double only (the e2e stack): another host for the YouTube Data API. Leave empty.
YOUTUBE_API_BASE_URL=
# Linking (vault agent service). Linking stays off while AGENT_SECRET is empty.
# Same secret as the agent's AGENT_SECRET: openssl rand -hex 32
AGENT_SECRET=
# Where the agent service listens (http://agent:8100 in Docker, set by Compose)
AGENT_URL=http://localhost:8100
# How long one linking request to the agent may take, in milliseconds (empty: 120000)
AGENT_TIMEOUT_MS=
# How long one syllabus draft by the agent may take, in milliseconds; keep it above the agent's own 180 s (empty: 200000)
AGENT_SYLLABUS_TIMEOUT_MS=
# Folder that holds one vault per user (empty: /vaults)
VAULTS_PATH=
# Where the SQLite database lives (default: <OS temp dir>/atlas-data)
DATA_DIR=
# Litestream's metrics URL, e.g. http://litestream:9090/metrics. Only set on the VM; it adds the
# admin's Replication row to the Status panel (ADR 0076)
LITESTREAM_METRICS_URL=
# Set to false on the VM, where the admin sets vaults up and users can only claim an existing
# folder (ADR 0075). Default: true
VAULT_CREATE_ENABLED=
# Folder the vault sync containers write <vault folder>.json status files to. Only set on the VM;
# it adds each user's Vault sync row to the Status panel (ADR 0075)
VAULT_SYNC_STATUS_DIR=
# Folder with the built web app; leave empty in development (Vite serves it)
WEB_DIR=
# Vault folder new notes go to unless another is chosen in the review screen (default: Mnemosyne)
DEFAULT_NOTE_FOLDER=
# How long one summary request may take, in milliseconds
SUMMARY_TIMEOUT_MS=300000
# Hours a job waits in review (or failed summary) before it is deleted
REVIEW_TTL_HOURS=24
# Minutes between sweeps that delete expired jobs
CLEANUP_INTERVAL_MINUTES=15
# Log level: fatal, error, warn, info, debug, trace or silent (empty: info)
LOG_LEVEL=
# Minutes between background checks of the agent service and the transcription model (empty: 2)
STATUS_CHECK_INTERVAL_MINUTES=

# --- Melete (optional) ---

# Google Calendar for Themis (ADR 0108). The consent screen returns here, so it must be listed on the
# OAuth client: https://<your origin>/api/calendar/oauth/callback. Empty: Calendar stays off.
CALENDAR_REDIRECT_URI=
# How many days back a calendar sync reads, 1 to 90 (empty: 14)
CALENDAR_LOOKBACK_DAYS=

# Time zone for Melete's day boundary (IANA name; empty: Asia/Singapore)
APP_TIME_ZONE=
# Hour (0-23) the Melete day starts, so late-night reviews count toward the day before (empty: 4)
MELETE_DAY_START_HOUR=
# Share of reviewed questions you aim to remember, above 0.7 up to 0.99 (empty: 0.9)
MELETE_REQUEST_RETENTION=
# How long grading one answer may take, in milliseconds (empty: 20000)
MELETE_GRADING_TIMEOUT_MS=
# How long generating questions for one note may take, in milliseconds (empty: 120000)
MELETE_GENERATION_TIMEOUT_MS=

# --- Sign-in (optional) ---

# Days a sign-in lasts without use (empty: 30)
SESSION_DAYS=