{
  "$defs": {
    "AgentHealthResponse": {
      "properties": {
        "claude_credential": {
          "$ref": "#/$defs/ClaudeCredential"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "vault": {
          "const": "readable",
          "title": "Vault",
          "type": "string"
        }
      },
      "required": [
        "status",
        "vault",
        "claude_credential"
      ],
      "title": "AgentHealthResponse",
      "type": "object"
    },
    "AgentUsage": {
      "properties": {
        "cache_creation_input_tokens": {
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cache_read_input_tokens": {
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "title": "Output Tokens",
          "type": "integer"
        },
        "tool_calls": {
          "title": "Tool Calls",
          "type": "integer"
        },
        "turns": {
          "title": "Turns",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cache_read_input_tokens",
        "cache_creation_input_tokens",
        "tool_calls",
        "turns"
      ],
      "title": "AgentUsage",
      "type": "object"
    },
    "ClaudeCredential": {
      "enum": [
        "federation",
        "api_key"
      ],
      "title": "ClaudeCredential",
      "type": "string"
    },
    "FailedLinkResponse": {
      "properties": {
        "outcome": {
          "const": "failed",
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "suggestions": {
          "items": {
            "$ref": "#/$defs/LinkSuggestion"
          },
          "maxItems": 0,
          "title": "Suggestions",
          "type": "array"
        },
        "usage": {
          "$ref": "#/$defs/AgentUsage"
        }
      },
      "required": [
        "outcome",
        "reason",
        "suggestions",
        "usage"
      ],
      "title": "FailedLinkResponse",
      "type": "object"
    },
    "InstructionsResponse": {
      "properties": {
        "instructions": {
          "title": "Instructions",
          "type": "string"
        }
      },
      "required": [
        "instructions"
      ],
      "title": "InstructionsResponse",
      "type": "object"
    },
    "LinkNote": {
      "properties": {
        "body": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "folder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Folder"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "tags",
        "folder",
        "body"
      ],
      "title": "LinkNote",
      "type": "object"
    },
    "LinkRequest": {
      "properties": {
        "guidance": {
          "maxLength": 20000,
          "title": "Guidance",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "note": {
          "$ref": "#/$defs/LinkNote"
        },
        "vault_dir": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$",
          "title": "Vault Dir",
          "type": "string"
        }
      },
      "required": [
        "note",
        "vault_dir",
        "model",
        "guidance"
      ],
      "title": "LinkRequest",
      "type": "object"
    },
    "LinkResponse": {
      "discriminator": {
        "mapping": {
          "failed": "#/$defs/FailedLinkResponse",
          "linked": "#/$defs/LinkedResponse"
        },
        "propertyName": "outcome"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LinkedResponse"
        },
        {
          "$ref": "#/$defs/FailedLinkResponse"
        }
      ],
      "title": "LinkResponse"
    },
    "LinkSuggestion": {
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Anchor"
        },
        "kind": {
          "$ref": "#/$defs/SuggestionKind"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "target",
        "kind",
        "anchor",
        "reason"
      ],
      "title": "LinkSuggestion",
      "type": "object"
    },
    "LinkedResponse": {
      "properties": {
        "outcome": {
          "const": "linked",
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "null"
        },
        "suggestions": {
          "items": {
            "$ref": "#/$defs/LinkSuggestion"
          },
          "title": "Suggestions",
          "type": "array"
        },
        "usage": {
          "$ref": "#/$defs/AgentUsage"
        }
      },
      "required": [
        "outcome",
        "reason",
        "suggestions",
        "usage"
      ],
      "title": "LinkedResponse",
      "type": "object"
    },
    "SuggestionKind": {
      "enum": [
        "existing_note",
        "existing_concept",
        "new_concept"
      ],
      "title": "SuggestionKind",
      "type": "string"
    }
  }
}
