{
  "name": "atlas",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "test": "node scripts/gate.mjs --tests",
    "gate": "node scripts/gate.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "e2e": "pnpm --filter @atlas/e2e e2e"
  }
}
