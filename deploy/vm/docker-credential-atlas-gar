#!/bin/sh
# Docker credential helper for Artifact Registry on a VM that has no gcloud (ADR 0077).
# bootstrap.sh installs it as /usr/local/bin/docker-credential-atlas-gar and points Docker at it
# with {"credHelpers": {"<region>-docker.pkg.dev": "atlas-gar"}}. Docker calls `get` with the
# registry host on stdin; the answer is an access token for the VM's service account, from the
# metadata server. Nothing is stored.
set -eu

[ "${1:-}" = "get" ] || { echo "docker-credential-atlas-gar only supports 'get'" >&2; exit 1; }

server=$(cat | tr -d '\r\n ')
body=$(curl -fsS -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token)
token=$(printf '%s' "$body" | tr -d '\n\r ' | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p')
[ -n "$token" ] || { echo "no access token from the metadata server" >&2; exit 1; }

printf '{"ServerURL":"%s","Username":"oauth2accesstoken","Secret":"%s"}\n' "$server" "$token"
