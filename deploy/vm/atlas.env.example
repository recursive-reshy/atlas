# Copied to /etc/atlas/atlas.env by deploy/vm/bootstrap.sh when that file does not exist; edit it
# there. Settings only: the six secrets come from Secret Manager (ADR 0078) and are not listed.

# The release to run; empty until the first deploy, when deploy/vm/deploy.sh sets it
ATLAS_VERSION=
# Where the images are: <region>-docker.pkg.dev/<project id>/<repository>
REGISTRY=asia-southeast1-docker.pkg.dev/your-project-id/atlas

# The Google account that becomes the admin on the first sign-in
ADMIN_EMAIL=you@example.com
# The address the app is served at (the Tailscale name), comma-separated, no path
APP_ORIGINS=https://atlas.your-tailnet.ts.net
# The OAuth client's ID (its secret is in Secret Manager)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The folder that holds one vault folder per person, and the folders bootstrap.sh creates beside it
VAULTS_HOST_PATH=/srv/atlas/vaults
# The Cloud Storage bucket the database is replicated to
LITESTREAM_BUCKET=your-project-id-atlas-db

# Gemini transcribes YouTube videos through the Gemini Developer API (ADR 0083). The model;
# the API key is the gemini-api-key secret
GEMINI_MODEL=gemini-3.8-flash

APP_TIME_ZONE=Asia/Singapore
# A new vault folder would have no sync container, so the VM cannot create one (ADR 0075)
VAULT_CREATE_ENABLED=false

# Optional tunables (same names as .env.example)
# LOG_LEVEL=info
# STATUS_CHECK_INTERVAL_MINUTES=2
